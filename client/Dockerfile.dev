FROM node:20-alpine

WORKDIR /app

# Install dependencies first for layer caching
COPY package*.json ./
RUN npm install

# Copy source code (will be overridden by volume mount for hot reloading, but good for standalone testing)
COPY . .

# Expose port
EXPOSE 5173

# Run Vite in dev mode and expose host so it's accessible outside the container
CMD ["npm", "run", "dev", "--", "--host"]
